# MarketMind AI Environment Configuration

# Database Configuration (Defaults to local SQLite if not specified)
DATABASE_URL=sqlite:///./market_mind_ai.db
# PostgreSQL example: postgresql://user:password@localhost:5432/marketmind

# Redis Configuration (Defaults to in-memory fallback if Redis is not running)
REDIS_URL=redis://localhost:6379/0

# LLM Orchestration API Keys (Optional - Intelligent fallback active if empty)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Financial Data API Keys (yfinance used as primary free real-time source)
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
NEWS_API_KEY=

# Application Settings
APP_ENV=development
SECRET_KEY=marketmind_secret_super_key_2026
